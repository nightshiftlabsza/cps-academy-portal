# CPS Academy Portal - Server Environment Variables
# NEVER expose credentials in client-side code or public repositories.

# Sync Endpoint Configuration (Disabled by default)
SYNC_SHEET_ID=
SYNC_ALLOWED_TABS=Morning Report,CPS Academy VMRs,CRC,Members
SYNC_AUTH_TOKEN=
SYNC_SERVICE_ACCOUNT_KEY=

# Phase 9: Apps Script Webhook Doorbell
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_WEBHOOK_SECRET=

# Authentication
UNIVERSAL_PASSWORD=

# Phase 10: Serverless Postgres (Neon / Vercel Postgres)
POSTGRES_URL=
